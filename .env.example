# ── AI 画布工作台 · 环境变量配置 ──
# 复制此文件为 .env.local 并填入对应 API Key
# ⚠️ .env.local 已加入 .gitignore，请勿在 .env 中写入真实 Key

# ── OpenAI ──
# https://platform.openai.com/api-keys
# 支持：GPT-4o / DALL·E 3 / o4-mini
OPENAI_API_KEY=

# ── DeepSeek ──
# https://platform.deepseek.com/api_keys
# 支持：DeepSeek V3 / R1
DEEPSEEK_API_KEY=

# ── 通义千问 / 万相（阿里 DashScope）──
# https://dashscope.aliyuncs.com/
# 支持：Qwen3 Max / Plus / 通义万相 2.1 / CosyVoice 2
DASHSCOPE_API_KEY=

# ── Kimi (Moonshot) ──
# https://platform.moonshot.cn/
# 支持：moonshot-v1-auto / 8k / 32k / 128k
MOONSHOT_API_KEY=

# ── 火山引擎 即梦/即梦视频（字节方舟 Ark）──
# 1. 开通模型：https://console.volcengine.com/ark/region:ark+cn-beijing/openManagement
#    → 搜索 Seedance / Seedream → 点击开通
# 2. 创建 API Key：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
# 3. 填入下方
# 支持：Seedance 2.0/1.5/1.0 · Seedream 4.5/4.0
ARK_API_KEY=

# ── 智谱 GLM / CogView / CogVideo ──
# https://open.bigmodel.cn/
# 支持：GLM-4 Plus / CogView-4 / CogVideoX
ZHIPU_API_KEY=

# ── 上传文件大小限制（字节，默认 100MB = 104857600）──
NEXT_PUBLIC_MAX_UPLOAD_SIZE=104857600

# ── JWT 签名密钥（⚠️ 生产环境必须修改为随机长字符串）──
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-secret-here-change-in-production

# ── 邮件服务（用于注册邮箱验证码）──
# 支持任意 SMTP 服务商：Gmail / QQ 邮箱 / 网易 / 阿里企业邮箱 等
#
# Gmail 示例（需开启「应用专用密码」，不支持普通密码）：
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#   SMTP_USER=you@gmail.com   SMTP_PASS=<16位应用密码>
#
# QQ 邮箱示例（需在邮箱设置 → 账户中开启 SMTP 并获取授权码）：
#   SMTP_HOST=smtp.qq.com     SMTP_PORT=587  SMTP_SECURE=false
#   SMTP_USER=xxxxxx@qq.com   SMTP_PASS=<授权码，非QQ密码>
#
# ⚠️ 不配置 SMTP_USER/SMTP_PASS 时，注册不要求邮箱验证码（仅用户名+密码）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# 发件人显示名称（留空则使用 SMTP_USER）
SMTP_FROM=

# ── Google OAuth 2.0 ──
# 1. 前往 https://console.cloud.google.com/apis/credentials
# 2. 创建「OAuth 2.0 客户端 ID」（应用类型：Web 应用）
# 3. 在「已获授权的重定向 URI」中添加：http://localhost:3000/api/auth/google/callback
# 4. 将客户端 ID 和密钥填入下方
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 生产环境设置为实际域名，开发时留空自动使用 localhost:3000
NEXTAUTH_URL=http://localhost:3000
